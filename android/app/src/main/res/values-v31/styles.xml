<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system starting window uses a transparent leaf, not the launcher plate. -->
    <style name="AppTheme" parent="BaseAppTheme">
        <!-- The system owns the launch icon; the Activity background must not repeat it smaller. -->
        <item name="android:windowBackground">@color/app_launch_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/app_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_leaf_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
