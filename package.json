{
  "name": "mangoleaf-ai",
  "version": "0.5.4",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged --config .lintstagedrc.json",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "security:install": "bun tools/install-gitleaks.mjs",
    "security:check": "bun tools/check-security.mjs",
    "security:dependencies": "bun audit",
    "test:tooling": "bun test ./tools",
    "test:build": "bun tools/build-test-app.mjs",
    "test:e2e": "bun tools/run-browser-tests.mjs e2e",
    "test:reliability": "bun tools/run-browser-tests.mjs reliability",
    "test:report": "playwright show-report playwright-report/e2e",
    "test:report:reliability": "playwright show-report playwright-report/reliability",
    "verify:export": "bun tools/verify-export.mjs",
    "verify:training-archive": "node tools/verify-training-archive.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.11",
    "@supabase/supabase-js": "^2.110.7",
    "@tensorflow/tfjs": "^4.22.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.11"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "busboy": "1.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "browserslist": "4.28.7"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
