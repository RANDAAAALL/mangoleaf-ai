{
  "name": "mangoleaf-ai",
  "version": "0.4.6",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged --config .lintstagedrc.json",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "security:install": "bun tools/install-gitleaks.mjs",
    "security:check": "bun tools/check-security.mjs",
    "test:tooling": "bun test ./tools",
    "verify:export": "bun tools/verify-export.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.11",
    "@supabase/supabase-js": "^2.110.7",
    "@tensorflow/tfjs": "^4.22.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
