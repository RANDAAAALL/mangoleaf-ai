# Public Supabase API settings. Never put a secret/service_role key here.
# Anonymous Sign-Ins, owner policies, and a private scans bucket are also required.
# See docs/supabase/SECURITY-AND-SYNC.md for configuration and migration instructions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
