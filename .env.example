# Public Supabase API settings. Never put a secret/service_role key here.
# The current app requires public guidelines SELECT and Realtime only.
# See docs/supabase/SECURITY-AND-SYNC.md; earlier cloud scan resources are historical.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
