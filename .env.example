# Public Supabase API settings. Never put a secret/service_role key here.
# Browser landing pages perform no private backup. Android: the public key supports
# automatic private backup after the reviewed SQL/Edge Function is deployed.
# Server service-role keys and provisioning flags belong only in Edge secrets.
# Production's server-only gate is ANDROID_BACKUP_PROVISIONING_ENABLED=true.
# Set it in the Supabase Edge Function secrets dashboard, never as NEXT_PUBLIC_*.
# See docs/security/SECURITY-AND-SYNC.md and docs/versions/ANDROID_APK_VERSIONING.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Keep production values in .env.local. Create a SEPARATE ignored .env.testing.local
# with the same two variable names and the mangoleafai-testing URL/public key.
# bun run dev and the default android:bundle read that file explicitly, overriding
# inherited production variables. android:bundle --release reads production settings.
# Project identities are checked in src/lib/cloud-target.ts; a wrong project fails closed.
# Automatic backup Auth requires both "Allow anonymous sign-ins" and "Allow new users to sign up"
# in its dashboard. These are server settings, not additional public environment variables.
# Both APK variants upload automatically to their pinned projects; browsers never upload.
