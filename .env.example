# Public client settings only; never add secret/service_role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Production: .env.local. Testing: separate ignored .env.testing.local, same names.
# dev/default android:bundle select testing; android:bundle --release selects production.
# APK backup starts after recovery-code setup; websites never upload scans/photos.
# Auth, provisioning and server-only secrets: SETUP.md and docs/security/SECURITY-AND-SYNC.md.
